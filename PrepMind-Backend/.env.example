GEMINI_API_KEY=your_gemini_api_key_here       # Get from aistudio.google.com
GROQ_API_KEY=your_groq_api_key_here          # Get from console.groq.com (free, for Whisper STT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
DEEPGRAM_API_KEY=your_deepgram_api_key        # Optional — enables live Voice Agent WebSocket
ALLOWED_ORIGINS=*                             # Prod: comma-separated app domains e.g. https://prepmind.vercel.app
RAG_ENABLED=true                              # pgvector + Gemini embeddings (set false to disable RAG)
STRICT_AUTH=false                             # true = require a verified JWT on every protected request
FREE_MONTHLY_EVALUATIONS=10                   # Server-enforced monthly evaluation quota per user
ENV=production                                # Shown by /api/version; use "development" locally
